exports[`DurationsEditor > matches the durations editor structure 1`] = `"<div><h2>Duración de cada tipo de visita</h2><p>Los turnos ya agendados conservan la duración con la que se reservaron.</p><div><label><span>Consulta · Primera vez</span><select aria-label="Consulta · Primera vez"><option value="10">10 min</option><option value="20">20 min</option><option value="30">30 min</option><option value="40">40 min</option><option value="50">50 min</option><option value="60">60 min</option><option value="70">70 min</option><option value="80">80 min</option><option value="90">90 min</option><option value="100">100 min</option><option value="110">110 min</option><option value="120">120 min</option></select></label><label><span>Consulta · Seguimiento</span><select aria-label="Consulta · Seguimiento"><option value="10">10 min</option><option value="20">20 min</option><option value="30">30 min</option><option value="40">40 min</option><option value="50">50 min</option><option value="60">60 min</option><option value="70">70 min</option><option value="80">80 min</option><option value="90">90 min</option><option value="100">100 min</option><option value="110">110 min</option><option value="120">120 min</option></select></label><label><span>Práctica · Criocirugía</span><select aria-label="Práctica · Criocirugía"><option value="10">10 min</option><option value="20">20 min</option><option value="30">30 min</option><option value="40">40 min</option><option value="50">50 min</option><option value="60">60 min</option><option value="70">70 min</option><option value="80">80 min</option><option value="90">90 min</option><option value="100">100 min</option><option value="110">110 min</option><option value="120">120 min</option></select></label><label><span>Práctica · Electrocoagulación</span><select aria-label="Práctica · Electrocoagulación"><option value="10">10 min</option><option value="20">20 min</option><option value="30">30 min</option><option value="40">40 min</option><option value="50">50 min</option><option value="60">60 min</option><option value="70">70 min</option><option value="80">80 min</option><option value="90">90 min</option><option value="100">100 min</option><option value="110">110 min</option><option value="120">120 min</option></select></label><label><span>Práctica · Biopsia</span><select aria-label="Práctica · Biopsia"><option value="10">10 min</option><option value="20">20 min</option><option value="30">30 min</option><option value="40">40 min</option><option value="50">50 min</option><option value="60">60 min</option><option value="70">70 min</option><option value="80">80 min</option><option value="90">90 min</option><option value="100">100 min</option><option value="110">110 min</option><option value="120">120 min</option></select></label></div><button type="button">Guardar duraciones</button></div>"`;
