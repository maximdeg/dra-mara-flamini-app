// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BookingWindowEditor > matches the booking window editor structure 1`] = `"<div><h2>Ventana de reservas</h2><p>Los pacientes pueden reservar desde mañana hasta el plazo elegido. Los turnos ya agendados no se ven afectados.</p><div><label><span>Reservas hasta</span><select aria-label="Reservas hasta"><option value="14">2 semanas</option><option value="30">1 mes</option><option value="45">1 ½ meses</option><option value="60">2 meses</option><option value="75">2 ½ meses</option><option value="90">3 meses</option><option value="105">3 ½ meses</option><option value="120">4 meses</option><option value="135">4 ½ meses</option><option value="150">5 meses</option><option value="165">5 ½ meses</option><option value="180">6 meses</option></select></label></div><button type="button">Guardar ventana de reservas</button></div>"`;
